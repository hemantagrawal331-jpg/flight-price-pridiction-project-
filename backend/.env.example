# Copy to .env and edit
MONGO_URI=mongodb://localhost:27017
DB_NAME=flight_tracker
PORT=5000
CORS_ORIGINS=http://localhost:5173

# Price provider: "simulated" (works offline) or "live" (scrapes SCRAPE_URL_TEMPLATE)
PROVIDER=simulated
# How often (minutes) the background job re-checks tracked flights
CHECK_INTERVAL_MIN=15
# Simulated market moves every N minutes (use 1-2 to see tracking change quickly in a demo)
SIM_BUCKET_MIN=5

# --- Live scraper (only if PROVIDER=live). Respect the site's robots.txt and terms of use. ---
SCRAPE_URL_TEMPLATE=https://example.com/flights?from={src}&to={dst}&date={date}
SCRAPE_SELECTORS={"card":".flight-card","airline":".airline","flight_number":".flight-no","departure":".dep-time","arrival":".arr-time","price":".price","seats":".seats","stops":".stops"}
SCRAPE_DELAY_SEC=2
