{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "npm install && npm run build",
  "functions": {
    "wsgi.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,public/**}",
      "excludeFiles": "{node_modules/**,frontend/**,dist/**,backend/.venv/**,backend/tests/**}"
    }
  }
}
